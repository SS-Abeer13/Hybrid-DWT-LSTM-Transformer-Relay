  chart {
    id			    18
    machine		    1
    name		    "Hybrid 87T Relay/Supervisory Override with Hardware Fallback"
    windowPosition	    [422 539.941 189 413]
    viewLimits		    [0 156.75 0 153.75]
    screen		    [1 1 3600 1200 1.180555555555556]
    treeNode		    [0 19 0 0]
    viewObj		    18
    ssIdHighWaterMark	    7
    decomposition	    CLUSTER_CHART
    type		    EML_CHART
    chartFileNumber	    4
    disableImplicitCasting  1
    eml {
      name		      "Hybrid_87T_Decision"
    }
    firstData		    20
    firstTransition	    25
    firstJunction	    24
  }
  state {
    id			    19
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    18
    treeNode		    [18 0 0 0]
    superState		    SUBCHART
    subviewer		    18
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function Trip_Signal = Hybrid_87T_Decision(Idiff_rms, Irest_rms, lstm_conf)\n    % Inputs:\n    %"
      "   Idiff_rms: 3x1 vector of differential current RMS magnitudes (p.u.)\n    %   Irest_rms: 3x1 vector of restrai"
      "nt current RMS magnitudes (p.u.)\n    %   lstm_conf: scalar, WT-LSTM AI confidence score (0.0 to 1.0)\n    %    "
      "          *** Input -1 to disable AI and default to pure 87T logic ***\n    % Output:\n    %   Trip_Signal: 1 (T"
      "rip Breaker) or 0 (Block/Normal)\n\n    % --- RELAY SETTINGS ---\n    I_pickup = 0.30;\n    I_high_set = 10.0;\n"
      "    Slope_1 = 0.25;\n    Slope_2 = 0.60;\n    Breakpoint = 3.0;\n    AI_Threshold = 0.85;\n    \n    Trip_Signal"
      " = 0; % Default state is to block/stay closed\n    \n    % --- PHASE-BY-PHASE EVALUATION ---\n    for ph = 1:3\n"
      "        Id = Idiff_rms(ph);\n        Ir = Irest_rms(ph);\n        \n        % 1. INSTANTANEOUS OVERRIDE (Catastr"
      "ophic Fault)\n        if Id > I_high_set\n            Trip_Signal = 1;\n            return; % Exit loop immediat"
      "ely, send trip signal!\n        end\n        \n        % 2. ADAPTIVE 87T LOGIC (The Physics)\n        trip_87t ="
      " 0;\n        if Id > I_pickup\n            if Ir <= Breakpoint\n                % Region 1 Logic (Light faults)\n"
      "                if Id > (Slope_1 * Ir)\n                    trip_87t = 1;\n                end\n            else"
      "\n                % Region 2 Logic (Heavy saturation bias)\n                dynamic_bias = (Slope_2 * (Ir - Brea"
      "kpoint)) + (Slope_1 * Breakpoint);\n                if Id > dynamic_bias\n                    trip_87t = 1;\n   "
      "             end\n            end\n        end\n        \n        % 3. HYBRID AI HANDSHAKE & FALLBACK\n        i"
      "f trip_87t == 1\n            if lstm_conf == -1\n                % FALLBACK MODE: AI is disabled (Default). \n  "
      "              % The 87T logic dictates the trip independently.\n                Trip_Signal = 1;\n              "
      "  return;\n                \n            elseif lstm_conf >= AI_Threshold\n                % HYBRID MODE: AI is "
      "active and confirms the fault.\n                Trip_Signal = 1;\n                return;\n                \n   "
      "         end\n            % If lstm_conf is between 0.0 and 0.84, it is an AI Veto (Inrush/Sat).\n            % "
      "The loop continues, and Trip_Signal remains 0.\n        end\n    end\nend"
    }
  }
