    disableImplicitCasting  1
    eml {
      name		      "Yd1_Compensation"
    }
    firstData		    11
    firstTransition	    16
    firstJunction	    15
  }
  state {
    id			    10
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    9
    treeNode		    [9 0 0 0]
    superState		    SUBCHART
    subviewer		    9
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function [I_hv_comp, I_lv_comp] = Yd1_Compensation(I_hv_sec, I_lv_sec)\n    % Inputs: \n    % I_h"
      "v_sec: 3x1 vector of raw HV secondary currents (from CT)\n    % I_lv_sec: 3x1 vector of raw LV secondary current"
      "s (from CT)\n    \n    % --- 1. ENTER YOUR SPECIFIC SYSTEM NOMINAL CURRENTS HERE ---\n    % These are the expect"
      "ed secondary CT currents during full normal load.\n    I_nom_hv = 1.506; \n    I_nom_lv = 31.492;\n    \n    % -"
      "-- 2. Magnitude Compensation (Convert to Per-Unit) ---\n    I_hv_pu = I_hv_sec / I_nom_hv;\n    I_lv_pu = I_lv_s"
      "ec / I_nom_lv;\n    \n    % --- 3. Vector Group Compensation (The Yd1 Matrix) ---\n    % Shifts HV Wye side by -"
      "30 degrees and traps zero-sequence\n    M_Yd1 = (1 / sqrt(3)) * [ 1,  0, -1;\n                             -1,  "
      "1,  0;\n                              0, -1,  1 ];\n                              \n    % Apply matrix to the HV"
      " side\n    I_hv_comp = M_Yd1 * I_hv_pu;\n    \n    % The LV Delta side is already at the reference angle and nat"
      "urally \n    % traps zero-sequence, so it passes through directly in p.u.\n    I_lv_comp = I_lv_pu;\nend"
    }
  }
  data {
    id			    11
    ssIdNumber		    4
    name		    "I_hv_sec"
    scope		    INPUT_DATA
    machine		    1
    props {
