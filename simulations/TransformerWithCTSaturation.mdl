  state {
    id			    3
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    2
    treeNode		    [2 0 0 0]
    superState		    SUBCHART
    subviewer		    2
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function features = DWT_Feature_Extraction(I_diff_window)\n    % Inputs: I_diff_window (16x3 matr"
      "ix from the Buffer block)\n    % Outputs: features (1x6 vector for the LSTM)\n    \n    % --- CRITICAL SIMULINK "
      "COMMAND ---\n    % The 'dwt' function is from the Wavelet Toolbox. \n    % Simulink's C-code generator doesn't s"
      "upport it, \n    % so Simulink is instructed to run it via the MATLAB engine.\n    coder.extrinsic('dwt');\n    "
      "\n    % Initialize output array [Ea_A, Ed_A, Ea_B, Ed_B, Ea_C, Ed_C]\n    features = zeros(1, 6);\n    \n    % P"
      "rocess each phase independently (just like the offline script)\n    for ph = 1:3\n        signal = I_diff_window"
      "(:, ph);\n        \n        % Initialize variables for code generation compliance\n        cA = zeros(11, 1); % "
      "db4 on 16 samples yields 11 approx coeffs\n        cD = zeros(11, 1);  %**MATLAB Version Specific\n        \n   "
      "     % Wavelet Decomposition\n        [cA, cD] = dwt(signal, 'db4');\n        \n        % Energy Calculation\n  "
      "      E_approx = sum(cA.^2);\n        E_detail = sum(cD.^2);\n        \n        % Store features\n        idx = "
      "(ph - 1) * 2 + 1;\n        features(idx) = E_approx;\n        features(idx + 1) = E_detail;\n    end\nend"
    }
  }
  data {
    id			    4
    ssIdNumber		    4
    name		    "I_diff_window"
    scope		    INPUT_DATA
    machine		    1
    props {
      array {
	size			"-1"
      }
      type {
	method			SF_INHERITED_TYPE
	primitive		SF_DOUBLE_TYPE
      }
